# Supabase (existing project — do not replace)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for real payments and for stamping the verified
# payment reference onto an order. NEVER expose to the client and never commit
# real values.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (optional — leave blank to hide the Razorpay option at checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree (optional — leave blank to hide the Cashfree option at checkout)
# Get both from https://dashboard.cashfree.com/account-settings/api-keys
# CASHFREE_ENV is "sandbox" (default) or "production".
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Email delivery for 6-digit OTP codes (optional but recommended).
# Free key from https://resend.com — without it the app falls back to
# Supabase's built-in mailer, whose default templates contain no 6-digit code.
RESEND_API_KEY=
RESEND_FROM=
